# Production frontend image (RC / staging). Dev workflow uses frontend/Dockerfile.
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS deps

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
COPY scripts/validate-node-toolchain.mjs ./scripts/validate-node-toolchain.mjs
COPY scripts/validate-lockfile-registry.mjs ./scripts/validate-lockfile-registry.mjs
COPY scripts/validate-installed-dependency-tree.mjs ./scripts/validate-installed-dependency-tree.mjs
COPY scripts/check-node-engine.mjs ./scripts/check-node-engine.mjs
RUN node scripts/validate-node-toolchain.mjs \
    && node scripts/validate-lockfile-registry.mjs \
    && npm ci \
    && node scripts/validate-installed-dependency-tree.mjs

FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_APP_NAME=Listnara
ARG NEXT_PUBLIC_LISTING_AUDIT_INTERNAL_ENABLED=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_LISTING_AUDIT_INTERNAL_ENABLED=${NEXT_PUBLIC_LISTING_AUDIT_INTERNAL_ENABLED}
ENV NODE_ENV=production

RUN npm run build

FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apk add --no-cache libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 \
    && addgroup -S -g 1001 nodejs \
    && adduser -S -D -H -u 1001 -G nodejs nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY scripts/validate-frontend-runtime.mjs ./scripts/validate-frontend-runtime.mjs

RUN test "$(npm root -g)" = "/usr/local/lib/node_modules" \
    && test -d /usr/local/lib/node_modules/npm \
    && corepack disable \
    && npm uninstall -g npm \
    && rm -rf /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx \
    && node scripts/validate-frontend-runtime.mjs

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/login >/dev/null || exit 1

CMD ["node", "server.js"]
