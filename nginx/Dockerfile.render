FROM nginx:1.30-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

# The official nginx entrypoint renders templates from /etc/nginx/templates.
# Restrict substitution to Render-provided topology values so nginx variables
# such as $host and $remote_addr remain intact.
ENV NGINX_ENVSUBST_FILTER="^(PORT|BACKEND_HOSTPORT|FRONTEND_HOSTPORT)$"

COPY nginx.render.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 10000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD-SHELL wget -qO- "http://127.0.0.1:${PORT:-10000}/health" >/dev/null || exit 1
