upstream render_backend {
    server ${BACKEND_HOSTPORT};
}

upstream render_frontend {
    server ${FRONTEND_HOSTPORT};
}

# Rate-limit with the TCP peer Render actually connected. Cloudflare's
# CF-Connecting-IP is forgeable until a trusted proxy chain is proven, so it
# is not used as a client-identity signal in this internal RC adapter.
limit_req_zone $binary_remote_addr zone=oauth_callback_per_ip:10m rate=30r/m;

server {
    listen ${PORT};
    server_name _;

    client_max_body_size 10M;

    # OAuth query parameters contain authorization material. Suppress callback
    # access logs and keep nginx limit_req messages below the configured level.
    error_log stderr error;
    limit_req_log_level notice;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /api/v1/amazon/oauth/callback {
        access_log off;
        limit_req zone=oauth_callback_per_ip burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://render_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Render terminates public TLS before forwarding to this web service.
        # Overwrite rather than trust a client-provided forwarding header.
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://render_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /docs {
        return 404;
    }

    location /redoc {
        return 404;
    }

    location /openapi.json {
        return 404;
    }

    location /health {
        proxy_pass http://render_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://render_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
