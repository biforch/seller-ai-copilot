# Copy to .env.vultr, keep mode 0600, and replace every placeholder.
# Never commit .env.vultr or paste its values into logs, issues, or chat.
ENVIRONMENT=production
POSTGRES_USER=listnara_app
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD
POSTGRES_DB=listnara_prod
DATABASE_URL=postgresql://listnara_app:REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD@postgres:5432/listnara_prod
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
OPENAI_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.4-mini
OPENAI_REFERER=https://app.listnara.com
OPENAI_TITLE=Listnara
OPENAI_AMAZON_DATA_ENABLED=false
OPENAI_DATA_RETENTION_MODE=default
CORS_ORIGINS=https://app.listnara.com
SESSION_COOKIE_SECURE=true
APP_NAME=Listnara
DEBUG=false
LEGACY_GENERATION_ENABLED=false
ANALYSIS_PUBLIC_ENABLED=false
PADDLE_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PLUS_PRODUCT_ID=pro_01m1c22yfxjbsra1c71y65ra32
PADDLE_PLUS_PRICE_ID=pri_01m1c2ar1tcp3cv8d8ax72q7qm
PADDLE_PRO_PRODUCT_ID=pro_01m1c23v04xh4sj3n7n5rzb66q
PADDLE_PRO_PRICE_ID=pri_01m1c28ybwv2d5gt7wp1hzd8kp
LISTING_AUDIT_INTERNAL_ENABLED=true
AMAZON_SP_API_ENABLED=false
AMAZON_OAUTH_ENABLED=false
AMAZON_SP_API_ENDPOINT_MODE=mock
AMAZON_SP_API_REGION=na
