# Copy to a local, untracked `.env.rc` for disposable RC runs.
# Replace every REPLACE_* placeholder before starting. Do NOT commit `.env.rc`.
#
# Generate URL-safe secrets at runtime (do not paste into Git or review artifacts):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # DB password (URL-safe)

ENVIRONMENT=staging
POSTGRES_USER=sellerai_rc
POSTGRES_PASSWORD=REPLACE_WITH_RC_DATABASE_PASSWORD
POSTGRES_DB=sellerai_rc_test
DATABASE_URL=postgresql://sellerai_rc:REPLACE_WITH_RC_DATABASE_PASSWORD@postgres:5432/sellerai_rc_test

# Runtime-generated at deploy time; example placeholder only — not for production.
JWT_SECRET_KEY=REPLACE_WITH_RUNTIME_GENERATED_SECRET_MIN_32_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# RC smoke does not call real LLM; placeholder satisfies config validation only.
OPENAI_API_KEY=rc-placeholder-not-for-real-llm

# Browser reaches API through nginx same-origin proxy.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Listnara
NEXT_PUBLIC_LISTING_AUDIT_INTERNAL_ENABLED=false
RC_HTTP_PORT=8080

# Frozen product capabilities. Public Analysis cannot be enabled before B3.
LEGACY_GENERATION_ENABLED=false
ANALYSIS_PUBLIC_ENABLED=false
LISTING_AUDIT_INTERNAL_ENABLED=false

# Amazon capabilities are disabled by default. Enabling requires replacing every
# relevant placeholder and using an externally reachable HTTPS OAuth callback.
AMAZON_SP_API_ENABLED=false
AMAZON_SP_API_ENDPOINT_MODE=mock
AMAZON_SP_API_REGION=na
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_USER_AGENT=Listnara/1.0.0 (Language=Python)
AMAZON_TOKEN_ACTIVE_KEY_VERSION=0
AMAZON_TOKEN_KEY_V1=
AMAZON_TOKEN_FINGERPRINT_PEPPER=
AMAZON_OAUTH_ENABLED=false
AMAZON_SP_API_APPLICATION_ID=
AMAZON_OAUTH_REDIRECT_URI=
AMAZON_OAUTH_FRONTEND_SUCCESS_URL=
AMAZON_OAUTH_FRONTEND_ERROR_URL=
AMAZON_OAUTH_CONSENT_VERSION=
AMAZON_OAUTH_STATE_TTL_SECONDS=600
