DATABASE_URL=postgresql://sellerai:sellerai123@postgres:5432/sellerai
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=sk-xxx
JWT_SECRET_KEY=your-secret-key
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
DEBUG=false
LEGACY_GENERATION_ENABLED=false
ANALYSIS_PUBLIC_ENABLED=false
LISTING_AUDIT_INTERNAL_ENABLED=false
AMAZON_SP_API_ENABLED=false
AMAZON_SP_API_ENDPOINT_MODE=mock
AMAZON_SP_API_REGION=na
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_USER_AGENT=Listnara/1.0.0 (Language=Python)
# Amazon refresh token encryption (32-byte keys, base64url). Required when persisting accounts.
AMAZON_TOKEN_ACTIVE_KEY_VERSION=1
AMAZON_TOKEN_KEY_V1=REPLACE_WITH_BASE64URL_32_BYTE_KEY
# AMAZON_TOKEN_KEY_V0=REPLACE_WITH_LEGACY_BASE64URL_32_BYTE_KEY
AMAZON_TOKEN_FINGERPRINT_PEPPER=REPLACE_WITH_BASE64URL_PEPPER
# Amazon OAuth fields are required only when AMAZON_OAUTH_ENABLED=true.
AMAZON_OAUTH_ENABLED=false
AMAZON_SP_API_APPLICATION_ID=
AMAZON_OAUTH_REDIRECT_URI=
AMAZON_OAUTH_FRONTEND_SUCCESS_URL=
AMAZON_OAUTH_FRONTEND_ERROR_URL=
AMAZON_OAUTH_CONSENT_VERSION=
AMAZON_OAUTH_STATE_TTL_SECONDS=600

